        },
        {
          "suffix": "finish_paint",
          "item_type": "ceiling_finish_paint",
          "unit": "m2",
          "factor": 1.0,
          "context_tags": ["ceiling", "finish", "paint"],
          "inputs": {
            "system": "ceiling_paint"
          },
          "assumptions": [
