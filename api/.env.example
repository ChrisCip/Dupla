# Copy to .env and fill in secrets. Used by API, worker, and domain code under lib/.

# Job storage (default: ./data under the api directory)
# JOB_DATA_DIR=/app/data

# Redis (RQ)
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=dupla_jobs

# API
# API_PREFIX=/api/v1
# MAX_UPLOAD_MB=200

# Autodesk Platform Services (see lib/aps_integration/aps_auth.py — uses these names)
CLIENT_ID=
CLIENT_SECRET=
APS_BUCKET_NAME=

# OpenAI (required for future vision stages; APS job uses dotenv-loaded env)
OPENAI_API_KEY=

# Budget: bundled catalog api/data/TGIU.bc3 (override if needed)
# BC3_CATALOG_PATH=/absolute/path/to/catalog.bc3
# PRES_XLSX_PATH=/path/to/PRES.xlsx
